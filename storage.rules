rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public assets (e.g., thumbnails) can be read by anyone but never written directly
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Admin uploads require authenticated user
    match /admin/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Default deny for everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
