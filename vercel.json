{
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/admin.html",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/model.html",
      "destination": "/model",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/model",
      "destination": "/model.html"
    },
    {
      "source": "/model/:id",
      "destination": "/model.html?id=:id"
    }
  ]
}
