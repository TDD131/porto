{
  "cleanUrls": true,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/admin.html",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/model.html",
      "destination": "/model",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/view/:projectId",
      "destination": "/api/view/[projectId]"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/model",
      "destination": "/model.html"
    },
    {
      "source": "/model/:id",
      "destination": "/model.html?id=:id"
    },
    {
      "source": "/software",
      "destination": "/software.html"
    }
  ]
}
