rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Projects: anyone can read, only auth can write EXCEPT like_count
    match /projects/{projectId} {
      allow read: if true;

      // Authenticated users (admin) can write anything
      allow write: if request.auth != null;

      // Unauthenticated users can ONLY update like_count field
      allow update: if request.auth == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['like_count']);
    }

    // All other collections: read public, write auth only
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
